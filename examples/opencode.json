{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "mcp": {
    "okta": {
      "type": "local",
      "command": ["okta-mcp"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "OKTA_ORG_URL": "{env:OKTA_ORG_URL}",
        "OKTA_API_TOKEN": "{env:OKTA_API_TOKEN}"
      }
    },
    "entra": {
      "type": "local",
      "command": ["entra-mcp"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "AZURE_TENANT_ID": "{env:AZURE_TENANT_ID}",
        "AZURE_CLIENT_ID": "{env:AZURE_CLIENT_ID}",
        "AZURE_CLIENT_SECRET": "{env:AZURE_CLIENT_SECRET}"
      }
    },
    "lumos": {
      "type": "local",
      "command": ["lumos-mcp"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "LUMOS_API_TOKEN": "{env:LUMOS_API_TOKEN}",
        "LUMOS_BASE_URL": "{env:LUMOS_BASE_URL}"
      }
    },
    "sailpoint": {
      "type": "local",
      "command": ["sailpoint-mcp"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "SAILPOINT_TENANT": "{env:SAILPOINT_TENANT}",
        "SAILPOINT_CLIENT_ID": "{env:SAILPOINT_CLIENT_ID}",
        "SAILPOINT_CLIENT_SECRET": "{env:SAILPOINT_CLIENT_SECRET}",
        "SAILPOINT_BASE_URL": "{env:SAILPOINT_BASE_URL}",
        "SAILPOINT_TOKEN_URL": "{env:SAILPOINT_TOKEN_URL}"
      }
    },
    "c1": {
      "type": "local",
      "command": ["c1-mcp"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "C1_CLIENT_ID": "{env:C1_CLIENT_ID}",
        "C1_CLIENT_SECRET": "{env:C1_CLIENT_SECRET}",
        "C1_BASE_URL": "{env:C1_BASE_URL}",
        "C1_TOKEN_URL": "{env:C1_TOKEN_URL}"
      }
    }
  },
  "tools": {
    "okta*": false,
    "entra*": false,
    "lumos*": false,
    "sailpoint*": false,
    "c1*": false
  },
  "agent": {
    "orchestrate": {
      "description": "Contributor coordinator. No source edits, no IdP MCP.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "okta*": "deny",
        "entra*": "deny",
        "lumos*": "deny",
        "sailpoint*": "deny",
        "c1*": "deny",
        "task": {
          "*": "deny",
          "implement": "allow",
          "review": "allow"
        }
      }
    },
    "implement": {
      "description": "Writes Go and tests. No live IdP MCP.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "okta*": "deny",
        "entra*": "deny",
        "lumos*": "deny",
        "sailpoint*": "deny",
        "c1*": "deny"
      }
    },
    "review": {
      "description": "Composes hidden blind lanes. No edits.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "okta*": "deny",
        "entra*": "deny",
        "lumos*": "deny",
        "sailpoint*": "deny",
        "c1*": "deny",
        "task": {
          "*": "deny",
          "lane-rules": "allow",
          "lane-security": "allow",
          "lane-completeness": "allow",
          "lane-eng-core": "allow",
          "lane-mcp": "allow"
        }
      }
    },
    "iga-operator": {
      "description": "IGA operator. Live Okta/Entra/Lumos/SailPoint/C1 reads. No repo edits.",
      "mode": "primary",
      "tools": {
        "okta*": true,
        "entra*": true,
        "lumos*": true,
        "sailpoint*": true,
        "c1*": true
      },
      "permission": {
        "edit": "deny",
        "task": "deny",
        "okta*": "allow",
        "entra*": "allow",
        "lumos*": "allow",
        "sailpoint*": "allow",
        "c1*": "allow"
      }
    }
  }
}
