{
  "schema_version": "mcp-authz-policy/v1",
  "gateway_id": "prod-lumos-write-gw-01",
  "server_name": "lumos-write-mcp",
  "pin_mode": "strict_all",
  "reverify_manifest_before_write": true,
  "tcb": {
    "isolation_mode": "mode_b_uid_boundary",
    "service_uid": 991,
    "forbidden_uids": [501, 1000],
    "lockfile_path": "/private/etc/identity-mcp/lumos-write.lock.json",
    "state_db_path": "/private/var/lib/identity-mcp/lumos-write/state.db",
    "audit_log_path": "/private/var/lib/identity-mcp/lumos-write/audit.jsonl",
    "challenge_dir": "/private/var/lib/identity-mcp/lumos-write/challenges",
    "empty_home_dir": "/private/var/lib/identity-mcp/lumos-write/empty-home",
    "admin_pubkey": "ed25519-hex:<64-hex-admin-ed25519-public-key>",
    "policy_sig_path": "/private/etc/identity-mcp/lumos-write.policy.sig"
  },
  "upstream": {
    "command": "/usr/local/bin/lumos-mcp",
    "args": ["--enable-writes"],
    "env_file": "/private/etc/identity-mcp/lumos-write.env",
    "pass_env": ["LUMOS_BASE_URL", "LUMOS_API_TOKEN"],
    "secret_env_keys": ["LUMOS_API_TOKEN"],
    "call_timeout_ms": 15000,
    "max_output_bytes": 4194304
  },
  "principal_auth": {
    "require_jwt": true,
    "identity_claim": "uid",
    "identity_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
    "identity_case_mode": "preserve",
    "allowed_algs": ["EdDSA", "ES256", "RS256"],
    "issuer": "https://auth.example.com",
    "audience": "mcp-authz-gateway",
    "max_clock_skew_seconds": 30,
    "max_token_lifetime_seconds": 86400,
    "allow_per_call_jwt": false,
    "public_keys": {
      "idp-key-2026-01": "ed25519-hex:<64-hex-idp-ed25519-public-key>"
    },
    "claim_to_scope_map": {
      "groups": {
        "iam-operators": ["lumos:access_requests:create", "lumos:groups:manage"]
      }
    }
  },
  "agent_profile": {
    "agent_id": "iga-operator-write",
    "allowed_scopes": ["lumos:access_requests:create", "lumos:groups:manage"],
    "hide_unauthorized_tools": true,
    "budget_window_seconds": 3600,
    "max_write_calls_per_minute": 5,
    "max_write_targets_per_window": 10,
    "max_challenges_per_minute": 10
  },
  "protected_resources": {
    "user_ids": {
      "case_insensitive": false,
      "exact": ["lumos-u-breakglass1", "lumos-u-ceo00001"]
    },
    "group_ids": {
      "case_insensitive": false,
      "exact": ["lumos-g-superadmins", "lumos-g-tier0infra"]
    },
    "app_ids": {
      "case_insensitive": false,
      "exact": ["lumos-a-prodcloud01", "lumos-a-bankingcore"]
    }
  },
  "sod_rules": [
    {
      "rule_id": "SOD-LUMOS-01",
      "conflicting_entitlements": ["lumos-a-prodcloud01", "lumos-a-bankingcore"],
      "case_insensitive": false
    }
  ],
  "subject_existing_entitlements": {
    "lumos-u-bob0000001": ["lumos-a-prodcloud01"]
  },
  "step_up": {
    "max_approval_ttl_seconds": 300,
    "require_interactive_tty": true,
    "ticket_regex": "^(?:INC|REQ|CHG)-[0-9]{4,8}$",
    "approvers": {
      "secops-lead@example.com": {
        "pubkey": "ed25519-hex:<64-hex-secops-lead-ed25519-public-key>",
        "principal_ids": ["lumos-u-secopslead"],
        "emails": ["secops-lead@example.com"]
      },
      "iam-oncall@example.com": {
        "pubkey": "ed25519-hex:<64-hex-iam-oncall-ed25519-public-key>",
        "principal_ids": ["lumos-u-iamoncall0"],
        "emails": ["iam-oncall@example.com"]
      }
    }
  },
  "tools": {
    "create_access_request": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["lumos:access_requests:create"],
      "forbid_self_target": true,
      "primary_target_path": "user_id",
      "subject_target_bindings": [
        {
          "path": "user_id",
          "jwt_claims": ["uid"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "user_id",
          "categories": ["user_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        },
        {
          "path": "app_id",
          "categories": ["app_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-a-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "sod_binding": {
        "subject_path": "user_id",
        "subject_normalizer": "id_alnum",
        "subject_canonical_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
        "subject_case_mode": "preserve",
        "entitlement_path": "app_id",
        "entitlement_normalizer": "id_alnum",
        "entitlement_canonical_regex": "^lumos-a-[A-Za-z0-9]{6,32}$",
        "entitlement_case_mode": "preserve"
      },
      "arg_constraints": {
        "required_non_empty": ["user_id", "app_id", "reason"]
      },
      "redact_args": []
    },
    "remove_group_member": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["lumos:groups:manage"],
      "forbid_self_target": true,
      "primary_target_path": "user_id",
      "subject_target_bindings": [
        {
          "path": "user_id",
          "jwt_claims": ["uid"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "user_id",
          "categories": ["user_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-u-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        },
        {
          "path": "group_id",
          "categories": ["group_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^lumos-g-[A-Za-z0-9]{6,32}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "arg_constraints": {
        "required_non_empty": ["group_id", "user_id"]
      },
      "redact_args": []
    }
  }
}
