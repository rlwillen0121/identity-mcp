{
  "schema_version": "mcp-authz-policy/v1",
  "gateway_id": "prod-entra-write-gw-01",
  "server_name": "entra-write-mcp",
  "pin_mode": "strict_all",
  "reverify_manifest_before_write": true,
  "tcb": {
    "isolation_mode": "mode_b_uid_boundary",
    "service_uid": 991,
    "forbidden_uids": [501, 1000],
    "lockfile_path": "/private/etc/identity-mcp/entra-write.lock.json",
    "state_db_path": "/private/var/lib/identity-mcp/entra-write/state.db",
    "audit_log_path": "/private/var/lib/identity-mcp/entra-write/audit.jsonl",
    "challenge_dir": "/private/var/lib/identity-mcp/entra-write/challenges",
    "empty_home_dir": "/private/var/lib/identity-mcp/entra-write/empty-home",
    "admin_pubkey": "ed25519-hex:<64-hex-admin-ed25519-public-key>",
    "policy_sig_path": "/private/etc/identity-mcp/entra-write.policy.sig"
  },
  "upstream": {
    "command": "/usr/local/bin/entra-mcp",
    "args": ["--enable-writes"],
    "env_file": "/private/etc/identity-mcp/entra-write.env",
    "pass_env": ["AZURE_TENANT_ID", "AZURE_CLIENT_ID", "AZURE_CLIENT_SECRET", "GRAPH_BASE_URL"],
    "secret_env_keys": ["AZURE_CLIENT_SECRET"],
    "call_timeout_ms": 15000,
    "max_output_bytes": 4194304
  },
  "principal_auth": {
    "require_jwt": true,
    "identity_claim": "oid",
    "identity_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "identity_case_mode": "ascii_lower",
    "allowed_algs": ["EdDSA", "ES256", "RS256"],
    "issuer": "https://auth.example.com",
    "audience": "mcp-authz-gateway",
    "max_clock_skew_seconds": 30,
    "max_token_lifetime_seconds": 86400,
    "allow_per_call_jwt": false,
    "public_keys": {
      "idp-key-2026-01": "ed25519-hex:<64-hex-idp-ed25519-public-key>"
    },
    "claim_to_scope_map": {
      "groups": {
        "iam-operators": ["entra:groups:write", "entra:sessions:revoke"]
      }
    }
  },
  "agent_profile": {
    "agent_id": "iga-operator-write",
    "allowed_scopes": ["entra:groups:write", "entra:sessions:revoke"],
    "hide_unauthorized_tools": true,
    "budget_window_seconds": 3600,
    "max_write_calls_per_minute": 5,
    "max_write_targets_per_window": 10,
    "max_challenges_per_minute": 10
  },
  "protected_resources": {
    "user_ids": {
      "case_insensitive": true,
      "exact": ["00000000-0000-0000-0000-000000000001", "00000000-0000-0000-0000-000000000002"]
    },
    "group_ids": {
      "case_insensitive": true,
      "exact": ["00000000-0000-0000-0000-000000000010", "00000000-0000-0000-0000-000000000020"]
    }
  },
  "sod_rules": [
    {
      "rule_id": "SOD-FIN-01",
      "conflicting_entitlements": ["00000000-0000-0000-0000-000000000101", "00000000-0000-0000-0000-000000000102"],
      "case_insensitive": true
    }
  ],
  "subject_existing_entitlements": {
    "00000000-0000-0000-0000-000000000003": ["00000000-0000-0000-0000-000000000101"]
  },
  "step_up": {
    "max_approval_ttl_seconds": 300,
    "require_interactive_tty": true,
    "ticket_regex": "^(?:INC|REQ|CHG)-[0-9]{4,8}$",
    "approvers": {
      "secops-lead@example.com": {
        "pubkey": "ed25519-hex:<64-hex-secops-lead-ed25519-public-key>",
        "principal_ids": ["00000000-0000-0000-0000-0000000000aa"],
        "emails": ["secops-lead@example.com"]
      },
      "iam-oncall@example.com": {
        "pubkey": "ed25519-hex:<64-hex-iam-oncall-ed25519-public-key>",
        "principal_ids": ["00000000-0000-0000-0000-0000000000bb"],
        "emails": ["iam-oncall@example.com"]
      }
    }
  },
  "tools": {
    "add_group_member": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["entra:groups:write"],
      "forbid_self_target": true,
      "primary_target_path": "user_id",
      "subject_target_bindings": [
        {
          "path": "user_id",
          "jwt_claims": ["oid"],
          "normalizer": "uuid",
          "canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "case_mode": "ascii_lower",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "user_id",
          "categories": ["user_ids"],
          "normalizer": "uuid",
          "canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "case_mode": "ascii_lower",
          "optional": false
        },
        {
          "path": "group_id",
          "categories": ["group_ids"],
          "normalizer": "uuid",
          "canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "case_mode": "ascii_lower",
          "optional": false
        }
      ],
      "sod_binding": {
        "subject_path": "user_id",
        "subject_normalizer": "uuid",
        "subject_canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "subject_case_mode": "ascii_lower",
        "entitlement_path": "group_id",
        "entitlement_normalizer": "uuid",
        "entitlement_canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "entitlement_case_mode": "ascii_lower"
      },
      "arg_constraints": {
        "required_non_empty": ["user_id", "group_id"]
      },
      "redact_args": []
    },
    "revoke_sign_in_sessions": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["entra:sessions:revoke"],
      "forbid_self_target": true,
      "primary_target_path": "user_id",
      "subject_target_bindings": [
        {
          "path": "user_id",
          "jwt_claims": ["oid"],
          "normalizer": "uuid",
          "canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "case_mode": "ascii_lower",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "user_id",
          "categories": ["user_ids"],
          "normalizer": "uuid",
          "canonical_regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "case_mode": "ascii_lower",
          "optional": false
        }
      ],
      "arg_constraints": {
        "required_non_empty": ["user_id"]
      },
      "redact_args": []
    }
  }
}
