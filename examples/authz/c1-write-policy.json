{
  "schema_version": "mcp-authz-policy/v1",
  "gateway_id": "prod-c1-write-gw-01",
  "server_name": "c1-mcp",
  "pin_mode": "strict_all",
  "reverify_manifest_before_write": true,
  "tcb": {
    "isolation_mode": "mode_b_uid_boundary",
    "service_uid": 991,
    "forbidden_uids": [501, 1000],
    "lockfile_path": "/private/etc/identity-mcp/c1-write.lock.json",
    "state_db_path": "/private/var/lib/identity-mcp/c1-write/state.db",
    "audit_log_path": "/private/var/lib/identity-mcp/c1-write/audit.jsonl",
    "challenge_dir": "/private/var/lib/identity-mcp/c1-write/challenges",
    "empty_home_dir": "/private/var/lib/identity-mcp/c1-write/empty-home",
    "admin_pubkey": "ed25519-hex:<64-hex-admin-ed25519-public-key>",
    "policy_sig_path": "/private/etc/identity-mcp/c1-write.policy.sig"
  },
  "upstream": {
    "command": "/usr/local/bin/c1-mcp",
    "args": ["--enable-writes"],
    "env_file": "/private/etc/identity-mcp/c1-write.env",
    "pass_env": ["C1_CLIENT_ID", "C1_CLIENT_SECRET", "C1_BASE_URL", "C1_TOKEN_URL"],
    "secret_env_keys": ["C1_CLIENT_SECRET"],
    "call_timeout_ms": 15000,
    "max_output_bytes": 4194304
  },
  "principal_auth": {
    "require_jwt": true,
    "identity_claim": "uid",
    "identity_regex": "^[A-Za-z0-9._:-]{1,64}$",
    "identity_case_mode": "preserve",
    "allowed_algs": ["EdDSA", "ES256", "RS256"],
    "issuer": "https://auth.example.com",
    "audience": "mcp-authz-gateway",
    "max_clock_skew_seconds": 30,
    "max_token_lifetime_seconds": 86400,
    "allow_per_call_jwt": false,
    "public_keys": {
      "idp-key-2026-01": "ed25519-hex:<64-hex-idp-ed25519-public-key>"
    },
    "claim_to_scope_map": {
      "groups": {
        "iam-operators": ["c1:tasks:grant", "c1:tasks:revoke"]
      }
    }
  },
  "agent_profile": {
    "agent_id": "iga-operator-write",
    "allowed_scopes": ["c1:tasks:grant", "c1:tasks:revoke"],
    "hide_unauthorized_tools": true,
    "budget_window_seconds": 3600,
    "max_write_calls_per_minute": 5,
    "max_write_targets_per_window": 10,
    "max_challenges_per_minute": 10
  },
  "protected_resources": {
    "user_ids": {
      "case_insensitive": false,
      "exact": ["usr_breakglass_01", "usr_ceo_01"]
    },
    "entitlement_ids": {
      "case_insensitive": false,
      "exact": ["ent_superadmin_01", "ent_tier0_infra_01"]
    }
  },
  "sod_rules": [
    {
      "rule_id": "SOD-FIN-01",
      "conflicting_entitlements": ["ent_ap_initiator_01", "ent_ap_approver_01"],
      "case_insensitive": false
    }
  ],
  "subject_existing_entitlements": {
    "usr_bob_01": ["ent_ap_initiator_01"]
  },
  "step_up": {
    "max_approval_ttl_seconds": 300,
    "require_interactive_tty": true,
    "ticket_regex": "^(?:INC|REQ|CHG)-[0-9]{4,8}$",
    "approvers": {
      "secops-lead@example.com": {
        "pubkey": "ed25519-hex:<64-hex-secops-lead-ed25519-public-key>",
        "principal_ids": ["usr_secops_lead_01"],
        "emails": ["secops-lead@example.com"]
      },
      "iam-oncall@example.com": {
        "pubkey": "ed25519-hex:<64-hex-iam-oncall-ed25519-public-key>",
        "principal_ids": ["usr_iam_oncall_01"],
        "emails": ["iam-oncall@example.com"]
      }
    }
  },
  "tools": {
    "create_grant_task": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["c1:tasks:grant"],
      "forbid_self_target": true,
      "primary_target_path": "identity_user_id",
      "subject_target_bindings": [
        {
          "path": "identity_user_id",
          "jwt_claims": ["uid"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "identity_user_id",
          "categories": ["user_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        },
        {
          "path": "app_entitlement_id",
          "categories": ["entitlement_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "sod_binding": {
        "subject_path": "identity_user_id",
        "subject_normalizer": "id_alnum",
        "subject_canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
        "subject_case_mode": "preserve",
        "entitlement_path": "app_entitlement_id",
        "entitlement_normalizer": "id_alnum",
        "entitlement_canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
        "entitlement_case_mode": "preserve"
      },
      "arg_constraints": {
        "required_non_empty": ["app_id", "app_entitlement_id", "identity_user_id", "ticket_id", "justification"],
        "regex_match": {
          "ticket_id": "^(?:INC|REQ|CHG)-[0-9]{4,8}$"
        }
      },
      "redact_args": []
    },
    "create_revoke_task": {
      "enabled": true,
      "action_class": "write:high-risk",
      "required_scopes": ["c1:tasks:revoke"],
      "forbid_self_target": true,
      "primary_target_path": "identity_user_id",
      "subject_target_bindings": [
        {
          "path": "identity_user_id",
          "jwt_claims": ["uid"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "protected_target_bindings": [
        {
          "path": "identity_user_id",
          "categories": ["user_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        },
        {
          "path": "app_entitlement_id",
          "categories": ["entitlement_ids"],
          "normalizer": "id_alnum",
          "canonical_regex": "^[A-Za-z0-9._:-]{1,64}$",
          "case_mode": "preserve",
          "optional": false
        }
      ],
      "arg_constraints": {
        "required_non_empty": ["app_id", "app_entitlement_id", "identity_user_id", "ticket_id", "justification"],
        "regex_match": {
          "ticket_id": "^(?:INC|REQ|CHG)-[0-9]{4,8}$"
        }
      },
      "redact_args": []
    }
  }
}
