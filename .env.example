# Okta (SSWS API token from Admin Console → Security → API → Tokens)
# The shipped command accepts only an HTTPS Okta authority. Custom/private
# endpoints are rejected by the command; tests may opt in only through an
# explicitly injected client, never through inherited shell configuration.
OKTA_ORG_URL=https://example.okta.com
OKTA_API_TOKEN=

# Entra ID app registration (client credentials)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Production accepts only the public Microsoft Graph authority. Custom/private
# or sovereign Graph-compatible endpoints are rejected by the shipped command;
# tests may opt in only through an explicitly injected client.
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
