# Okta (SSWS API token from Admin Console → Security → API → Tokens)
OKTA_ORG_URL=https://example.okta.com
OKTA_API_TOKEN=

# Entra ID app registration (client credentials)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Lumos (Settings → API Tokens; prefix lsk_)
LUMOS_API_TOKEN=
# LUMOS_BASE_URL=https://api.lumos.com

# SailPoint Identity Security Cloud PAT
SAILPOINT_TENANT=
SAILPOINT_CLIENT_ID=
SAILPOINT_CLIENT_SECRET=
# SAILPOINT_BASE_URL=https://{tenant}.api.identitynow.com/v2026
# SAILPOINT_TOKEN_URL=https://{tenant}.api.identitynow.com/oauth/token

# ConductorOne (Read-Only Administrator; client id is <random>@<hostname>/<use>)
C1_CLIENT_ID=
C1_CLIENT_SECRET=
# C1_BASE_URL=https://<hostname>/api/v1
# C1_TOKEN_URL=https://<hostname>/auth/v1/token
