{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "mcp": {
    "okta": {
      "type": "local",
      "command": ["okta-mcp"],
      "enabled": false
    },
    "entra": {
      "type": "local",
      "command": ["entra-mcp"],
      "enabled": false
    }
  },
  "agent": {
    "orchestrate": {
      "description": "Contributor coordinator. No source edits, no IdP MCP.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "okta*": "deny",
        "entra*": "deny",
        "task": {
          "*": "deny",
          "implement": "allow",
          "review": "allow"
        }
      }
    },
    "implement": {
      "description": "Writes Go and tests. No live IdP MCP.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "okta*": "deny",
        "entra*": "deny"
      }
    },
    "review": {
      "description": "Composes hidden blind lanes. No edits.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "okta*": "deny",
        "entra*": "deny",
        "task": {
          "*": "deny",
          "lane-rules": "allow",
          "lane-security": "allow",
          "lane-completeness": "allow",
          "lane-eng-core": "allow",
          "lane-mcp": "allow"
        }
      }
    },
    "iga-operator": {
      "description": "IGA operator. Use only with the separate operator profile.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "okta*": "deny",
        "entra*": "deny"
      }
    }
  }
}
